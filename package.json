{
  "name": "agent-virtual-office",
  "version": "1.0.0",
  "description": "Pixel-art virtual office that visualizes AI agent activity in real-time. Works with Claude Code, Gemini CLI, Codex, and any tool that can POST status.",
  "main": "bin/cli.js",
  "bin": {
    "agent-virtual-office": "./bin/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "build:single": "vite build --outDir dist-single",
    "test": "vitest run",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "virtual-office",
    "agent",
    "ai",
    "pixel-art",
    "claude",
    "gemini",
    "codex",
    "visualization",
    "status"
  ],
  "author": "KbWen",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/KbWen/agent-virtual-office#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/KbWen/agent-virtual-office.git"
  },
  "type": "commonjs",
  "files": [
    "bin/",
    "public/",
    "src/",
    "index.html",
    "vite.config.js",
    "package.json"
  ],
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "vite": "^6.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "vitest": "^3.2.1"
  }
}
